PORT=3000
NODE_ENV=development
APP_ORIGIN=http://localhost:3000
# For phone testing on the same Wi-Fi, add the temporary LAN origin after a comma.
# Production: replace this with the exact HTTPS domain, e.g. https://amrei.example.com
SESSION_SECRET=ganti-dengan-secret-sendiri
DB_HOST=localhost
DB_PORT=3306
DB_NAME=database_amrei
DB_USER=
DB_PASSWORD=
# MySQL destination. Production: use DB_SSL=true and keep certificate verification enabled.
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true
DB_POOL_MAX=10
DB_CONNECTION_TIMEOUT_MS=10000
DB_IDLE_TIMEOUT_MS=30000
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
WHATSAPP_ENABLED=false
WA_QUEUE_DELAY_MS=60000
ADMIN_WHATSAPP=628xxxxxxxxxx
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
